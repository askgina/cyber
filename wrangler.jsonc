{
  "name": "breach-ledger",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // Public address. Cloudflare manages the DNS record and certificate.
  "routes": [
    { "pattern": "cyber.askgina.ai", "custom_domain": true }
  ],
  // Keep static assets asset-first, except for routes owned by the Worker.
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/", "/index.html", "/index.html/", "/index", "/index/",
      "/leaderboard", "/leaderboard/", "/report", "/report/", "/method", "/method/",
      "/api", "/api/",
      // The first two wildcards also cover /incidents/llms.txt and /patterns/llms.txt.
      "/incidents/*", "/patterns/*", "/daily/*",
      "/sitemap.xml", "/feed.xml", "/feed.json", "/schemamap.xml",
      "/llms.txt", "/llms-full.txt", "/method/llms.txt",
      "/index.md", "/leaderboard.md", "/report.md", "/method.md", "/api.md",
      "/404", "/404/", "/404.html", "/404.md",
      "/data.json", "/data-hot.json", "/data-details.json", "/data-history.json", "/archive.json",
      "/e", "/__build", "/api/search"
    ]
  },
  // Hourly build at :07, run in the Builder container.
  "triggers": {
    "crons": ["7 * * * *"]
  },
  // JSON build outputs and caches (state.tar.gz); AI Search documents (one file per type per day).
  "r2_buckets": [
    { "binding": "STATE", "bucket_name": "breach-ledger-state" },
    { "binding": "SEARCH_DOCS", "bucket_name": "breach-ledger-ai-search" }
  ],
  // Search by meaning over the ledger (⌘K), indexed from SEARCH_DOCS.
  "ai_search": [
    { "binding": "AI_SEARCH", "instance_name": "breach-ledger" }
  ],
  // Per IP per minute: 60 search requests, of which at most 10 may be cache misses; 120 analytics events.
  "ratelimits": [
    { "name": "SEARCH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SEARCH_REQ_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "EVENT_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  // Page loads and events (cookieless), queryable with the Analytics Engine SQL API.
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "cyber_events" }
  ],
  // standard-1 (1/2 vCPU): "basic" took ~9 min per build, too close to the 15-min cron limit.
  "containers": [
    // rollout_active_grace_period: a deploy waits up to 15 min for a running build before replacing the container.
    // max_instances 2: a renamed instance (hourly-vN) can start while an old one is still idling out.
    { "class_name": "Builder", "image": "./container/Dockerfile", "max_instances": 2, "instance_type": "standard-1", "rollout_active_grace_period": 900 }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BUILDER", "class_name": "Builder" }],
    // A deploy waits up to 15 min for an in-flight build before updating the Builder's code (default 5 min resets it).
    "code_update_strategy": { "mode": "deferred", "max_delay": 900 }
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Builder"] }
  ]
}
